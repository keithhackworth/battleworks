local view=controller.view
view.newWorld.Activated:Fire()
view.dimensions.width.Text="28";view.dimensions.width.FocusLost:Fire()
view.dimensions.depth.Text="28";view.dimensions.depth.FocusLost:Fire()
view.terrain.Activated:Fire()
view.surfaceTools.Tunnel.Activated:Fire()
view.tunnelFields.diameter.Text="12";view.tunnelFields.diameter.FocusLost:Fire()
controller:tunnelClick(Vector3.new(-6,0,0))
controller:tunnelClick(Vector3.new(6,0,0))
check(#controller.state.document.settings.tunnels==1,"two portal clicks create a tunnel")
check(controller.scene.terrain.folder:FindFirstChild("TunnelFloor")~=nil and controller.scene.terrain.folder:FindFirstChild("TunnelRoof")~=nil,"editor renders the tunnel floor and roof")
view.tunnelFields.diameter.Text="13";view.tunnelFields.diameter.FocusLost:Fire()
view.tunnelFields.traction.Text="40";view.tunnelFields.traction.FocusLost:Fire()
local tunnel=controller.state.document.settings.tunnels[1]
check(tunnel.diameter==13 and tunnel.traction==40,"diameter and traction update the selected tunnel")
local export=require("WorldEditorDocument").export(controller.state.document,controller.catalog)
controller:replaceDocument(export)
check(controller.state.document.settings.tunnels[1].diameter==13,"reopening a world restores its tunnel settings")
view.tunnelNext.Activated:Fire();view.tunnelDelete.Activated:Fire()
check(controller.state.document.settings.tunnels==nil,"deleting a tunnel removes its terrain cut")
controller:history(false)
check(#controller.state.document.settings.tunnels==1,"deleting a tunnel is undoable")
controller:destroy()
print("Tunnel editor, geometry and save/load checks passed")
