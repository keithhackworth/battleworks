    result = await_command(forward(distance))\n    stop()\n    after = get_current_coordinates()\n    progress = (after.x - before.x) * (after.x - before.x) + (after.z - before.z) * (after.z - before.z)\n    if progress < 0.25 or result.state != \"completed\":\n        await_command(back(2))\n        stop()\n        turn_to(get_tank_direction().world_direction + 55)\n    return progress\n\nfunction enemy(const scan):\n    if scan.status == \"success\":\n        index = 0\n        while index < scan.count:\n            hit = scan.detections[index]\n            if hit.type == \"tank\" and hit.relation == \"enemy\":\n                return hit\n            index = index + 1\n    return null\n\nfunction root(value):\n    guess = value + 1\n    iteration = 0\n    while iteration < 12:\n        guess = (guess + value / guess) / 2\n        iteration = iteration + 1\n    return guess\n\nfunction predict(const old, const scan):\n    hit = enemy(scan)\n    if hit == null:\n        return false\n    previous = enemy(old)\n    own = get_tank_state()\n    vx = 0\n    vy = 0\n    vz = 0\n    dt = scan.timestamp - old.timestamp\n    if previous != null and previous.player == hit.player and dt > 0.05 and dt < 5:\n        vx = (hit.point.x - previous.point.x) / dt\n        vy = (hit.point.y - previous.point.y) / dt\n        vz = (hit.point.z - previous.point.z) / dt\n    point = [hit.point.x, hit.point.y, hit.point.z]\n    muzzle = own.turret.muzzle_position\n    speed = own.weapon.projectile_speed\n    latency = get_clock().time - scan.timestamp\n    if own.turret.effective_rotation_speed > 0:\n        latency = latency + 90 / own.turret.effective_rotation_speed\n    if own.weapon.readiness.effective_preparation_seconds != null:\n        latency = latency + own.weapon.readiness.effective_preparation_seconds\n    flight = 0\n    iteration = 0\n    while iteration < 4 and speed != null and speed > 0 and own.weapon.projectile_model == \"projectile\":\n        point = [hit.point.x + vx * (latency + flight), hit.point.y + vy * (latency + flight), hit.point.z + vz * (latency + flight)]\n        flight = root((point[0] - muzzle.x) * (point[0] - muzzle.x) + (point[1] - muzzle.y) * (point[1] - muzzle.y) + (point[2] - muzzle.z) * (point[2] - muzzle.z)) / speed\n        iteration = iteration + 1\n    if flight > 5 or vx * vx + vy * vy + vz * vz > 2500:\n        point = [hit.point.x, hit.point.y, hit.point.z]\n    aligned = await_command(aim_at(point[0], point[1], point[2]))\n    fresh = Scanner(scan.sensor)\n    visible = enemy(fresh)\n    ready = is_weapon_ready()\n    if visible != null and visible.player == hit.player and aligned.state == \"completed\" and aligned.completionReason == null and ready.ready == true and get_clock().time - fresh.timestamp < 2:\n        if ready.operation == \"Heat\":\n            await_command(fire(1))\n        else:\n            await_command(fire())\n        return true\n    return false\n\n# P04 Sniper — reposition, settle, observe and lead; no invented crouch mechanic.\n# Settling at low speed doesn't prove that this position is good cover.\n# We assume constant velocity. What if the enemy turns during preparation?\nseed = 107\nsector = 0\nphase = \"reposition\"\nprint({personality: \"Sniper\", phase: phase})\nwhile true:\n    seed = random_step(seed)\n    turn_to(seed * 360 / 997)\n    progress = travel(4 + seed / 70)\n    phase = \"settle\"\n    print({personality: \"Sniper\", phase: phase})\n    wait_for_clock(get_clock().time + 1)\n    own = get_tank_state()\n    searches = 0\n    while searches < 8 and own.motion.airborne == false:\n        first = Scanner(sector * 45)\n        if enemy(first) != null:\n            second = Scanner(sector * 45)\n            phase = \"predict\"\n            print({personality: \"Sniper\", phase: phase})\n            fired = predict(first, second)\n        sector = sector + 1\n        if sector == 8:\n            sector = 0\n        searches = searches + 1\n    phase = \"reposition