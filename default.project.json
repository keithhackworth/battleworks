{
  "name": "battleworks",
  "tree": {
    "$className": "DataModel",
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": {
        "ChatVersion": "TextChatService",
        "CreateDefaultTextChannels": true,
        "CreateDefaultCommands": true
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "BattleWorksStudio": {
        "$className": "Configuration",
        "WorldStorageProvider": {
          "$className": "StringValue",
          "$properties": {
            "Value": "Http"
          }
        },
        "TeamTestMode": {
          "$className": "BoolValue",
          "$properties": {
            "Value": false
          }
        },
        "TeamTestHostUserId": {
          "$className": "StringValue",
          "$properties": {
            "Value": "0"
          }
        },
        "SelectedWorld": {
          "$path": "worlds/selected-world.model.json"
        },
        "WorldCatalog": {
          "$path": "worlds/studio-worlds.model.json"
        },
        "PublishedWorld": {
          "$path": "worlds/published-world.model.json"
        },
        "EditorAssetCatalog": {
          "$path": "assets/editor-catalog.model.json"
        },
        "GameMode": {
          "$className": "StringValue",
          "$properties": {
            "Value": "BattleRoyale"
          }
        },
        "PublicTankCount": {
          "$className": "IntValue",
          "$properties": {
            "Value": 6
          }
        },
        "PublicTankReplenishDelay": {
          "$className": "NumberValue",
          "$properties": {
            "Value": 5
          }
        }
      },
      "BattleWorksAssets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "$path": "assets/roblox",
        "__BattleWorksAssetIndex": {
          "$path": "assets/asset-index.model.json"
        },
        "Builtin": {
          "$path": "assets/builtin/catalog.model.json"
        }
      }
    }
  }
}
